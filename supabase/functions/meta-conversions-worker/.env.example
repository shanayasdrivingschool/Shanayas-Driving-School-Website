# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in deployed functions.
# Never use VITE_ names for these secrets. This file contains placeholders only.
META_CAPI_ENABLED=false
META_CAPI_MODE=test
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_SITE_ORIGIN=
META_TEST_EVENT_CODE=
META_WORKER_SECRET=

# Optional downstream stage names: leave blank until confirmed in Events Manager.
META_EVENT_QUALIFIED=
META_EVENT_BOOKED=
META_EVENT_UNQUALIFIED=

# Optional Instant Forms integration; website forms work without it.
META_LEADGEN_ENABLED=false
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
